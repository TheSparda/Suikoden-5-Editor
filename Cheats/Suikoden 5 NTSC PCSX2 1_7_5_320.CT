	<CheatEntry>
	  <ID>210</ID>
	  <Description>"Party SP Multiplier / Infinite Party SP (Enable After Loading Save/Starting New Game, Not At Title Menu)"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

tPartySPMult = createTimer(nil, false)
tPartySPMult.OnTimer = function(fPartySPMult)

  local PotchOffset = getAddressSafe("PotchOffset")
  local PartySPMult = ReadQword(getAddress(getAddress("PartySPMultiplier")))
  local PartySPInitialized = ReadQword(getAddress("PartySPInitialized"))
  local PartySPSaved = getAddress("SavedPartySP")
  local InfPartySP = ReadQword(getAddress("InfinitePartySP"))
  
  if (PotchOffset ~= nil) then
	if (PotchOffset ~= 0) then

	  if (PartySPInitialized == 0) then
		 WriteInteger(getAddress("PartySPInitialized"),1)
		 WriteInteger(PartySPSaved,ReadInteger(PotchOffset + 0x04))
	  else
		local PartySPDifference = ReadInteger(PotchOffset + 0x04) - ReadInteger(PartySPSaved)
		if (PartySPDifference &lt;= 0) then
		  if (InfPartySP == 1) then
			WriteInteger(PotchOffset + 0x04,ReadInteger(PartySPSaved))
		  else
			WriteInteger(PartySPSaved,ReadInteger(PotchOffset + 0x04))
		  end
		else
		  local PartySPMultiplied = PartySPDifference * PartySPMult
		  local NewPartySP = ReadInteger(PartySPSaved) + PartySPMultiplied
		  WriteInteger(PotchOffset+0x04,NewPartySP)
		  WriteInteger(PartySPSaved,NewPartySP)
		end
	  end		  

	end
  end

end
tPartySPMult.Interval = 250
tPartySPMult.Enabled = true

{$asm}

[DISABLE]
{$lua}

tPartySPMult.Destroy()
WriteInteger(getAddress("PartySPInitialized"),0)

{$asm}
</AssemblerScript>
