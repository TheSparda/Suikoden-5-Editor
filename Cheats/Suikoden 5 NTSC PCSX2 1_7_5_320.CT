</AssemblerScript>
	  <Hotkeys>
		<Hotkey>
		  <Action>Activate</Action>
		  <Keys>
			<Key>112</Key>
		  </Keys>
		  <ID>0</ID>
		</Hotkey>
	  </Hotkeys>
	</CheatEntry>
	<CheatEntry>
	  <ID>2</ID>
	  <Description>"Activate Trainer 2"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

local BaseProcessPtr = getAddressSafe(process)
local GetBasePointersAOB = getAddressSafe("GetBasePointersAOB")

if (GetBasePointersAOB ~= nil) then
	if (GetBasePointersAOB ~= 0) then
		local FindPotchBasePtrAdd = ReadInteger(GetBasePointersAOB+0x0D)
		local FindPotchBasePtr = GetBasePointersAOB + FindPotchBasePtrAdd + 0x07 + 0x0A
		local PotchBasePtrDifference = FindPotchBasePtr - BaseProcessPtr
		
		WritePointer(getAddressSafe("PotchOffsetOffset"),PotchBasePtrDifference)
				
		WritePointer(getAddressSafe("PartySPOffsetOffset"),PotchBasePtrDifference + ReadInteger(getAddressSafe("PartySPOffsetOffset")))
		WritePointer(getAddressSafe("FirstPartyCurrentHPOffset"),PotchBasePtrDifference + ReadInteger(getAddressSafe("FirstPartyCurrentHPOffset")))
		WritePointer(getAddressSafe("FirstPartyExpOffset"),PotchBasePtrDifference + ReadInteger(getAddressSafe("FirstPartyExpOffset")))
		WritePointer(getAddressSafe("FirstPartyItemOneQtyOffset"),PotchBasePtrDifference + ReadInteger(getAddressSafe("FirstPartyItemOneQtyOffset")))
		WritePointer(getAddressSafe("FirstPartyEXPPtrOffset"),PotchBasePtrDifference + ReadInteger(getAddressSafe("FirstPartyEXPPtrOffset")))
		WritePointer(getAddressSafe("FirstPartyItemOneQtyPtrOffset"),PotchBasePtrDifference + ReadInteger(getAddressSafe("FirstPartyItemOneQtyPtrOffset")))
	end
end

if (BaseProcessPtr ~= nil) then
	if (BaseProcessPtr ~= 0) then
		local FirstPartyExpOffset = ReadInteger(getAddressSafe("FirstPartyExpOffset"))
		local FirstPartyExp = FirstPartyExpOffset + BaseProcessPtr
		registerSymbol("FirstPartyExp",FirstPartyExp)
		
		local FirstPartyItemOneQtyOffset = ReadInteger(getAddressSafe("FirstPartyItemOneQtyOffset"))
		local FirstPartyItemOneQty = FirstPartyItemOneQtyOffset + BaseProcessPtr
		registerSymbol("FirstPartyItemOneQty",FirstPartyItemOneQty)
		
		local PotchOffsetOffset = ReadInteger(getAddressSafe("PotchOffsetOffset"))
		local PotchOffset = PotchOffsetOffset + BaseProcessPtr
		registerSymbol("PotchOffset",PotchOffset)

		local PartySPOffsetOffset = ReadInteger(getAddressSafe("PartySPOffsetOffset"))
		local PartySPOffset = PartySPOffsetOffset + BaseProcessPtr
		registerSymbol("PartySPOffset",PartySPOffset)

		local FirstPartyCurrentHPOffset = ReadInteger(getAddressSafe("FirstPartyCurrentHPOffset"))
		local FirstPartyCurrentHP = FirstPartyCurrentHPOffset + BaseProcessPtr
		registerSymbol("FirstPartyCurrentHP",FirstPartyCurrentHP)
		
		local FirstPartyEXPPtrOffset = ReadInteger(getAddressSafe("FirstPartyEXPPtrOffset"))
		local FirstPartyEXPPtr = FirstPartyEXPPtrOffset + BaseProcessPtr
		WritePointer(getAddressSafe("FirstPartyEXPPtr"),FirstPartyEXPPtr)

		local FirstPartyItemOneQtyPtrOffset = ReadInteger(getAddressSafe("FirstPartyItemOneQtyPtrOffset"))
		local FirstPartyItemOneQtyPtr = FirstPartyItemOneQtyPtrOffset + BaseProcessPtr
		WritePointer(getAddressSafe("FirstPartyItemOneQtyPtr"),FirstPartyItemOneQtyPtr)
		
	end
end

{$asm}

[DISABLE]

unregistersymbol(FirstPartyEXP)
unregistersymbol(FirstPartyItemOneQty)
unregistersymbol(PotchOffset)
unregistersymbol(PartySPOffset)
unregistersymbol(FirstPartyCurrentHP)

</AssemblerScript>
	  <Hotkeys>
		<Hotkey>
		  <Action>Activate</Action>
		  <Keys>
			<Key>112</Key>
		  </Keys>
		  <ID>0</ID>
		</Hotkey>
	  </Hotkeys>
	</CheatEntry>
	<CheatEntry>
	  <ID>3</ID>
	  <Description>"Activate Trainer 3"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

tMainTimer = createTimer(nil, false)
tMainTimer.OnTimer = function(fMainTimer)

	local OurProcess = getAddressSafe(process)
	local ourindex = 0
	local FirstPartyItemOneQty = getAddressSafe("FirstPartyItemOneQty")
	local FirstPartyExp = getAddressSafe("FirstPartyExp")
	local CharacterInfoOffset = ReadInteger(getAddressSafe("CharacterInfoOffset"))
	local CharacterInfoNumPartyMembers = ReadInteger(getAddressSafe("CharacterInfoNumPartyMembers"))
	local BattleInfoOffset = ReadInteger(getAddressSafe("BattleInfoOffset"))
	local FirstPartyCurrentHP = getAddressSafe("FirstPartyCurrentHP")
	local BattleInfoNumPartyMembers = ReadInteger(getAddressSafe("BattleInfoNumPartyMembers"))
	
	if (OurProcess ~= nil) then
		if (OurProcess ~= 0) then
			-- First, Do Character Options
			while (ourindex &lt; CharacterInfoNumPartyMembers) do
				local InfiniteItem = ReadInteger(getAddressSafe("InfiniteItem"))
				
				if (InfiniteItem == 1) then
					local Item1Qty = ReadBytes(FirstPartyItemOneQty + 0x01)
					if (Item1Qty ~= 0) then
						if (ReadBytes(FirstPartyItemOneQty) ~= Item1Qty) then
							WriteBytes(FirstPartyItemOneQty,Item1Qty)
						end
					end

					local Item2Qty = ReadBytes(FirstPartyItemOneQty + 0x09)
					if (Item2Qty ~= 0) then
						if (ReadBytes(FirstPartyItemOneQty+0x08) ~= Item2Qty) then
							WriteBytes(FirstPartyItemOneQty+0x08,Item2Qty)
						end
					end

					local Item3Qty = ReadBytes(FirstPartyItemOneQty + 0x11)
					if (Item3Qty ~= 0) then
						if (ReadBytes(FirstPartyItemOneQty+0x10) ~= Item3Qty) then
							WriteBytes(FirstPartyItemOneQty+0x10,Item3Qty)
						end
					end

					local Item4Qty = ReadBytes(FirstPartyItemOneQty + 0x19)
					if (Item4Qty ~= 0) then
						if (ReadBytes(FirstPartyItemOneQty+0x18) ~= Item4Qty) then
							WriteBytes(FirstPartyItemOneQty+0x18,Item4Qty)
						end
					end
				end
				
				local QuickLevelGain = ReadInteger(getAddressSafe("QuickLevelGain"))
				
				if (QuickLevelGain == 1) then
					if (ReadSmallInteger(FirstPartyExp) ~= 999) then
						WriteSmallInteger(FirstPartyExp,999)
					end
				end
				
				local SetSPAllParty = ReadInteger(getAddressSafe("SetSPAllParty"))
				
				if (SetSPAllParty == 1) then
					if (ReadSmallInteger(FirstPartyExp + 0x02) ~= 5000) then
						WriteSmallInteger(FirstPartyExp + 0x02,5000)
					end
				end
				
				local InfiniteRuneUse = ReadInteger(getAddressSafe("InfiniteRuneUse"))
				
				if (InfiniteRuneUse == 1) then
					local MaxRuneUse = ReadInteger(FirstPartyExp - 0x04)
					if (ReadInteger(FirstPartyExp - 0x08) ~= MaxRuneUse) then
						WriteInteger(FirstPartyExp - 0x08,MaxRuneUse)
					end
				end
				
				local SetAllSkillsToSS = ReadInteger(getAddressSafe("SetAllSkillsToSS"))
				
				if (SetAllSkillsToSS == 1) then
					if (ReadInteger(FirstPartyItemOneQty + 0x1E) ~= 0x07070707) then
						WriteInteger(FirstPartyItemOneQty + 0x1E,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x22,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x26,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x2A,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x2E,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x32,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x36,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x3A,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x3E,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x42,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x46,0x07070707)
						WriteInteger(FirstPartyItemOneQty + 0x4A,0x07070707)
						WriteBytes(FirstPartyItemOneQty + 0x4E,07)
					end
				end
				
				local SetAllPDFToMax = ReadInteger(getAddressSafe("SetAllPDFToMax"))
				
				if (SetAllPDFToMax == 1) then
					if (ReadSmallInteger(FirstPartyExp + 0xE) ~= 999) then
						WriteSmallInteger(FirstPartyExp + 0xE,999)
						WriteSmallInteger(FirstPartyExp + 0x11C,999)
					end
				end
				
				local SetAllMDFToMax = ReadInteger(getAddressSafe("SetAllMDFToMax"))
				
				if (SetAllMDFToMax == 1) then
					if (ReadSmallInteger(FirstPartyExp + 0x10) ~= 999) then
						WriteSmallInteger(FirstPartyExp + 0x10,999)
						WriteSmallInteger(FirstPartyExp + 0x11E,999)
					end
				end
				
				local SetAllAffinitiesToSAllChars = ReadInteger(getAddressSafe("SetAllAffinitiesToSAllChars"))
				
				if (SetAllAffinitiesToSAllChars == 1) then
					if (ReadInteger(FirstPartyExp + 0xDE) ~= 0x06060606) then
						WriteInteger(FirstPartyExp + 0xDE,0x06060606)
						WriteInteger(FirstPartyExp + 0xE2,0x06060606)
						WriteInteger(FirstPartyExp + 0xE6,0x06060606)
						WriteSmallInteger(FirstPartyExp + 0xEA,0x0606)
						
						WriteInteger(FirstPartyExp + 0xEC,0x06060606)
						WriteInteger(FirstPartyExp + 0xF0,0x06060606)
						WriteInteger(FirstPartyExp + 0xF4,0x06060606)
						WriteSmallInteger(FirstPartyExp + 0xF8,0x0606)

						WriteInteger(FirstPartyExp + 0xFA,0x06060606)
						WriteInteger(FirstPartyExp + 0xFE,0x06060606)
						WriteInteger(FirstPartyExp + 0x102,0x06060606)
						WriteSmallInteger(FirstPartyExp + 0x106,0x0606)
					end
				end
				
				ourindex = ourindex + 1
				FirstPartyExp = FirstPartyExp + CharacterInfoOffset
				FirstPartyItemOneQty = FirstPartyItemOneQty + CharacterInfoOffset
			end
			
			ourindex = 0
			
			-- Next, Do Battle Options
			while (ourindex &lt; BattleInfoNumPartyMembers) do
				local InfiniteHP = ReadInteger(getAddressSafe("InfiniteHP"))
				
				if (InfiniteHP == 1) then
					if (ReadBytes(FirstPartyCurrentHP - 0x30) == 0xF0) then
						local MaxHP = ReadSmallInteger(FirstPartyCurrentHP + 0x02)
						if (ReadSmallInteger(FirstPartyCurrentHP) ~= MaxHP) then
							WriteSmallInteger(FirstPartyCurrentHP,MaxHP)
						end
					end
				end

				local InfiniteRuneUseBattle = ReadInteger(getAddressSafe("InfiniteRuneUseBattle"))
				
				if (InfiniteRuneUseBattle == 1) then
					if (ReadBytes(FirstPartyCurrentHP - 0x30) == 0xF0) then
						local MaxRuneUseBattle = ReadInteger(FirstPartyCurrentHP + 0xB8)
						
						if (ReadInteger(FirstPartyCurrentHP + 0xB4) ~= MaxRuneUseBattle) then
							WriteInteger(FirstPartyCurrentHP + 0xB4,ReadInteger(FirstPartyCurrentHP + 0xB8))
						end
					end
				end

				ourindex = ourindex + 1
				FirstPartyCurrentHP = FirstPartyCurrentHP + BattleInfoOffset
			end
			
			-- Finally, Do Special ASM Options
			local TrainOnceForSSRankOffset = ReadPointer(getAddressSafe("TrainOnceForSSRankOffset"))
			local TrainOnceForSSRank = ReadInteger(getAddressSafe("TrainOnceForSSRank"))
			
			if (TrainOnceForSSRank == 1) then
				if (ReadInteger(TrainOnceForSSRankOffset + OurProcess) ~= 0x24020007) then
					WriteInteger(TrainOnceForSSRankOffset + OurProcess,0x24020007)
				end
			else
				if (ReadInteger(TrainOnceForSSRankOffset + OurProcess) ~= 0x24420001) then
					WriteInteger(TrainOnceForSSRankOffset + OurProcess,0x24420001)
				end				
			end
			
			local ForgeOnceSetsLevelToMaxOffset = ReadPointer(getAddressSafe("ForgeOnceSetsLevelToMaxOffset"))
			local ForgeOnceSetsLevelToMax = ReadInteger(getAddressSafe("ForgeOnceSetsLevelToMax"))
			
			if (ForgeOnceSetsLevelToMax == 1) then
				if (ReadInteger(ForgeOnceSetsLevelToMaxOffset + OurProcess) ~= 0x2403000F) then
					WriteInteger(ForgeOnceSetsLevelToMaxOffset + OurProcess,0x2403000F)
				end	
			else
				if (ReadInteger(ForgeOnceSetsLevelToMaxOffset + OurProcess) ~= 0x24630001) then
					WriteInteger(ForgeOnceSetsLevelToMaxOffset + OurProcess,0x24630001)
				end	
			end
			
			local BlacksmithsCanForgeToMaxLevelOffset = ReadPointer(getAddressSafe("BlacksmithsCanForgeToMaxLevelOffset"))
			local BlacksmithsCanForgeToMaxLevel = ReadInteger(getAddressSafe("BlacksmithsCanForgeToMaxLevel"))
			
			if (BlacksmithsCanForgeToMaxLevel == 1) then
				if (ReadInteger(BlacksmithsCanForgeToMaxLevelOffset + OurProcess) ~= 0x24130010) then
					WriteInteger(BlacksmithsCanForgeToMaxLevelOffset + OurProcess,0x24130010)
				end	
			else
				if (ReadInteger(BlacksmithsCanForgeToMaxLevelOffset + OurProcess) ~= 0x00A0982D) then
					WriteInteger(BlacksmithsCanForgeToMaxLevelOffset + OurProcess,0x00A0982D)
				end	
			end
			
			local AlliesTakeNoDamageWarBattlesOffset1 = ReadPointer(getAddressSafe("AlliesTakeNoDamageWarBattlesOffset1"))
			local AlliesTakeNoDamageWarBattlesOffset2 = ReadPointer(getAddressSafe("AlliesTakeNoDamageWarBattlesOffset2"))
			local AlliesTakeNoDamageWarBattles = ReadInteger(getAddressSafe("AlliesTakeNoDamageWarBattles"))
			
			if (AlliesTakeNoDamageWarBattles == 1) then
				if (ReadSmallInteger(AlliesTakeNoDamageWarBattlesOffset2 + OurProcess) == 0x6078) then
					if (ReadInteger(AlliesTakeNoDamageWarBattlesOffset1 + OurProcess) ~= 0) then
						WriteInteger(AlliesTakeNoDamageWarBattlesOffset1 + OurProcess,0)
					end
				end
			end

			local EnemiesInstantDeathWarBattlesOffset1 = ReadPointer(getAddressSafe("EnemiesInstantDeathWarBattlesOffset1"))
			local EnemiesInstantDeathWarBattlesOffset2 = ReadPointer(getAddressSafe("EnemiesInstantDeathWarBattlesOffset2"))
			local EnemiesInstantDeathWarBattles = ReadInteger(getAddressSafe("EnemiesInstantDeathWarBattles"))
			
			if (EnemiesInstantDeathWarBattles == 1) then
				if (ReadSmallInteger(EnemiesInstantDeathWarBattlesOffset2 + OurProcess) == 0x6078) then
					if (ReadInteger(EnemiesInstantDeathWarBattlesOffset1 + OurProcess) ~= 9999) then
						WriteInteger(EnemiesInstantDeathWarBattlesOffset1 + OurProcess,9999)
					end
				end
			end			
		end
	end
	
end

tMainTimer.Interval = 100
tMainTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}

tMainTimer.destroy()

{$asm}
</AssemblerScript>
