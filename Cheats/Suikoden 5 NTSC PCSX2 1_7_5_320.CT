<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="26">
  <CheatEntries>
	<CheatEntry>
	  <ID>1</ID>
	  <Description>"Activate Trainer (First Load A Game and View Main Menu, Then Activate Trainers)"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

lua_aobscan_2("GetBasePointersAOB",process,"89 F9 83 C1 14 48 63 7C 0D 00 4C 63 05 * * * *",1,0x100000000)

local CurrentSaveSymbolList = {
"InfiniteItem",
"InfiniteGP",
"InfiniteHP",
"InfinitePartySP",
"InfiniteRuneUse",
"InfiniteRuneUseBattle",
"QuickLevelGain",
"SetSPAllParty",
"SetAllSkillsToSS",
"SetAllPDFToMax",
"SetAllMDFToMax",
"SetAllAffinitiesToSAllChars",
"TrainOnceForSSRank",
"ForgeOnceSetsLevelToMax",
"BlacksmithsCanForgeToMaxLevel",
"AlliesTakeNoDamageWarBattles",
"EnemiesInstantDeathWarBattles",
"GPMultiplier",
"PartySPMultiplier"
}

-- First, make sure Save Symbol List global variable is empty
for i=#SaveSymbolList,1,-1 do
	table.remove(SaveSymbolList,i)
end

for j=1,#CurrentSaveSymbolList do
	-- Insert our custom symbol list for this trainer into the global variable
	table.insert(SaveSymbolList,CurrentSaveSymbolList[j])
end

{$asm}

alloc(newmem,2048)

///
label(FirstPartyCurrentHPOffset)
registersymbol(FirstPartyCurrentHPOffset)
label(PotchOffsetOffset)
registersymbol(PotchOffsetOffset)
label(PartySPOffsetOffset)
