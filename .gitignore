# Game images — never commit (large, copyrighted)
*.iso
*.bin
*.img
ISO/

# PS2 saves / memory cards — not distributed
*.ps2
*.psu
*.psv
*.cbs
*.sps
*.max
Saves/

# Backups the editor makes before writing
*.bak
# Hard Mode baseline sidecars
*.hardmode.json

