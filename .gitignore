Editor/Suikoden5Editor_monodis.il
Editor/*_monodis.il
Editor/_monodis.err
# Managed resources extracted from the third-party exe — not distributed
Editor/_res/

# Local cheat/reference files — not distributed
Cheats/

# Editor local state
Editor/.s5editor.json

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# editor/session config
.claude/
